<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.kamesh.todo.controller.CalendarController"
            stylesheets="@style.css">

    <!-- Top bar -->
    <top>
        <HBox styleClass="top-bar" spacing="10">
            <Button fx:id="menuBtn" text="☰" styleClass="menu-btn" onAction="#toggleMenu" />
            <Label styleClass="app-title" text="Todo" />
        </HBox>
    </top>

    <!-- Left drawer -->
    <left>
        <VBox fx:id="drawerPane" styleClass="drawer"
              visible="false" managed="false" prefWidth="200">
            <Label styleClass="drawer-title" text="MENU" />
            <Separator styleClass="drawer-sep" />
            <Button text="＋  Add Task" styleClass="drawer-item"
                    onAction="#openAddTask" maxWidth="Infinity" />
        </VBox>
    </left>

    <!-- Center: everything -->
    <center>
        <VBox>
            <!-- Month nav -->
            <HBox fx:id="monthNavBar" styleClass="month-nav-bar" spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="prevMonthBtn" text="‹" styleClass="nav-btn" onAction="#prevMonth" />
                <Label fx:id="monthLabel" styleClass="month-label" text="" />
                <Button fx:id="nextMonthBtn" text="›" styleClass="nav-btn" onAction="#nextMonth" />
            </HBox>

            <!-- Grid row: calendar grid + right task panel -->
            <HBox VBox.vgrow="ALWAYS">

                <!-- Calendar grid -->
                <ScrollPane fx:id="gridScroll" fitToHeight="true" styleClass="grid-scroll"
                            HBox.hgrow="ALWAYS" />

                <!-- Right panel: unassigned tasks list -->
                <VBox fx:id="taskPanel" styleClass="task-panel" prefWidth="220" minWidth="180">
                    <Label styleClass="task-panel-title" text="Available Tasks" />
                    <Label styleClass="task-panel-hint"
                           text="Click ＋ to add task to this month" wrapText="true"/>
                    <Separator styleClass="drawer-sep" />
                    <ScrollPane fx:id="taskPanelScroll" fitToWidth="true"
                                styleClass="task-panel-scroll" VBox.vgrow="ALWAYS" />
                </VBox>

            </HBox>

            <!-- Charts row -->
            <HBox fx:id="chartsRow" styleClass="charts-row" minHeight="280" prefHeight="300">
                <VBox fx:id="barPane" styleClass="chart-pane" HBox.hgrow="ALWAYS" />
                <Separator orientation="VERTICAL" styleClass="chart-divider" />
                <VBox fx:id="piePane" styleClass="chart-pane" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </center>

</BorderPane>
